TITLE Enceladus hydrothermal simulation
# Recommended database: coreclath_CH4coupled.dat (CH4 coupled -> aqueous/gas species are CH4/CH4(g); porewater T = 150.0 C)
# Ocean pressure 66.7 atm >= dissociation pressure 29.5 atm, so CH4 clathrates may be stable.
# Ocean pressure 66.7 atm >= dissociation pressure 15.4 atm, so CO2 clathrates may be stable.
# Ocean temperature 1.45 C < threshold temperature 9.85 C, so CO2 clathrates remain stable.
# Ocean pressure 66.7 atm >= dissociation pressure 1.17 atm, so H2S clathrates may be stable.
# Ocean temperature 1.45 C < threshold temperature 28.5 C, so H2S clathrates remain stable.
# Ocean: clathrates considered stable: CH4, CO2, H2S. Clathrates considered unstable: none.

# Porewater pressure 261 atm < dissociation pressure 2.51e+08 atm, so CH4 clathrates are not stable.
# Porewater pressure 261 atm < dissociation pressure 1.18e+04 atm, so CO2 clathrates are not stable.
# Porewater pressure 261 atm < dissociation pressure 1.41e+04 atm, so H2S clathrates are not stable.
# Porewater: clathrates considered stable: none. Clathrates considered unstable: CH4, CO2, H2S.

KNOBS
   -logfile true

# k=1e-07, thickness=194200 m
# Organic content: 15 wt.%
# Mode: ungrouped (1 orbital period per step)
# exchange_ratio (fluid/porewater per model cycle): N/A
# Simulation parameters:
# Layer thickness: 194200 m (100.0% of core)
# Layer mass: 6.24e+19 kg  (total_rock normalised to 1.0)
# Reaction time: 4.52e-02 years
# Total cycles: 12
# Time step: 3.76e-03 years per step
# Mean flow rate: 2.76e+09 L/s
# Circulation time: 2.43e+02 years
# Complete circulation time: 2.83e+03 years
# Corrected circulation time (f_fluid capped at f_pore): 2.43e+02 years
# Corrected complete circulation time: 2.83e+03 years
# Flowing fluid mass (per orbital cycle): 3.28e+14 kg
# Porewater mass: 9.82e+18 kg
# Ocean mass: 2.11e+19 kg

SOLUTION 1 Enceladus porewater
    temp      150
    pH        7
    pe        4
    redox     pe
    units     mol/kgw
    density   1
    water     0.157402852926709
    pressure  66.7#261.2

SOLUTION 2 Enceladus ocean
    temp      1.45
    pH        7
    pe        4
    redox     pe
    units     mol/kgw
    density   1
    water     0.338719998046012
    pressure  66.7

REACTION_TEMPERATURE 1
    150

REACTION_TEMPERATURE 2
    1.45

# Define rate equations for each mineral
RATES
Forsterite
	-start
	1   REM Ref PK04
	10  kacid = 10^(-6.85) * exp(-67.2e3/8.314 * (1/TK-1/298.15)) * ACT("H+")^0.47
	20  kneut = 10^(-10.64) * exp(-79.0e3/8.314 * (1/TK-1/298.15))
	21  SSA = 0.1
	22  mw = 140.6715
	40  k = (kacid + kneut) * SSA * mw * M
	50  IF SR("Forsterite") > 1 THEN rate = 0 ELSE rate = k * (1 - SR("Forsterite"))
	60  moles = rate * TIME
	70  SAVE moles
	-end
	
	Troilite # PK04 has no separate troilite entry; hexagonal pyrrhotite parameters used as proxy (same FeS chemistry)
        -start
        1   REM Acid mechanism only (PK04)
        2   REM Hexagonal pyrrhotite formulation (reaction orders H+ = -0.090, Fe3+ = 0.356) used for troilite
        3   REM Rate depends on H+ and Fe3+ activities
        25  kacid = 10^(-6.79) * exp(-63.0e3/8.314 * (1/TK-1/298.15)) * ACT("H+")^-0.090 * ACT("Fe+3")^0.356
        26  SSA = 5
        27  mw = 87.913
        30  k = kacid * SSA * mw * M
        40  IF SR("Troilite") > 1 THEN rate = 0 ELSE rate = k * (1 - SR("Troilite"))
        50  moles = rate * TIME
        55  IF moles < 0 THEN moles = 0
        60  SAVE moles
        -end

	Diopside
	-start
	1   REM Ref PK04
	10  kacid = 10^(-6.36) * exp(-96.1e3/8.314 * (1/TK-1/298.15)) * ACT("H+")^0.71
	20  kneut = 10^(-11.11) * exp(-40.6e3/8.314 * (1/TK-1/298.15))
	21  SSA = 0.1
	22  mw = 216.55
	40  k = (kacid + kneut) * SSA * mw * M
	50  IF SR("Diopside") > 1 THEN rate = 0 ELSE rate = k * (1 - SR("Diopside"))
	60  moles = rate * TIME
	70  SAVE moles
	-end

	K-Feldspar
	-start
	1   REM Ref PK04
	10  kacid = 10^(-10.06) * exp(-51.7e3/8.314 * (1/TK-1/298.15)) * ACT("H+")^0.5
	20  kneut = 10^(-12.41) * exp(-38.0e3/8.314 * (1/TK-1/298.15))
	30  kbase = 10^(-21.20) * exp(-94.1e3/8.314 * (1/TK-1/298.15)) * ACT("H+")^-0.823
	31  SSA = 5
	32  mw = 278.33
	40  k = (kacid + kneut + kbase) * SSA * mw * M
	50  IF SR("K-Feldspar") > 1 THEN rate = 0 ELSE rate = k * (1 - SR("K-Feldspar"))
	60  moles = rate * TIME
	70  SAVE moles
	-end

	Tephroite # TODO: rate constants not yet supplied (Mn-olivine) — k held at 0 (no dissolution) until provided
	-start
	1   REM TODO awaiting kacid/kneut from user
	10  kacid = 0
	20  kneut = 0
	21  SSA = 0.1
	22  mw = 201.96
	40  k = (kacid + kneut) * SSA * mw * M
	50  IF SR("Tephroite") > 1 THEN rate = 0 ELSE rate = k * (1 - SR("Tephroite"))
	60  moles = rate * TIME
	70  SAVE moles
	-end

	Enstatite
	-start
	1   REM Ref PK04
	10  kacid = 10^(-9.02) * exp(-80.0e3/8.314 * (1/TK-1/298.15)) * ACT("H+")^0.6
	20  kneut = 10^(-12.72) * exp(-80.0e3/8.314 * (1/TK-1/298.15))
	21  SSA = 0.1
	22  mw = 100.3725
	40  k = (kacid + kneut) * SSA * mw * M
	50  IF SR("Enstatite") > 1 THEN rate = 0 ELSE rate = k * (1 - SR("Enstatite"))
	60  moles = rate * TIME
	70  SAVE moles
	-end

    Anorthite # Ca-endmember of plagioclase
        -start
        1   REM Ref PK04
        10  kacid = 10^(-3.50) * exp(-16.6e3/8.314 * (1/TK-1/298.15)) * ACT("H+")^1.411
        20  kneut = 10^(-9.12) * exp(-17.8e3/8.314 * (1/TK-1/298.15))
        21  SSA = 5
        22  mw = 278.164
        40  k = (kacid + kneut) * SSA * mw * M
        50  IF SR("Anorthite") > 1 THEN rate = 0 ELSE rate = k * (1 - SR("Anorthite"))
        60  moles = rate * TIME
        70  SAVE moles
        -end
        
    Albite # Na-endmember of plagioclase
        -start
        1   REM 3 mechanisms: acid, neutral, base (PK04)
        2   REM Chemical affinity parameters p and q for albite are 0.760 and 90.0 respectively
        3   REM (Alekseyev et al., 1997), but their use in modeling should be limited to conditions 
        4   REM near the experimental conditions under which they were obtained, 300 Â°C and pH = 9.
        10  kacid = 10^(-10.16) * exp(-65.0e3/8.314 * (1/TK-1/298.15)) * ACT("H+")^0.457
        20  kneut = 10^(-12.56) * exp(-69.8e3/8.314 * (1/TK-1/298.15))
        30  kbase = 10^(-15.60) * exp(-71.0e3/8.314 * (1/TK-1/298.15)) * ACT("H+")^-0.572
        31  SSA = 5
        32  mw = 262.1798
        40  k = (kacid + kneut + kbase) * SSA * mw * M
        50  IF SR("Albite") > 1 THEN rate = 0 ELSE rate = k * (1 - SR("Albite"))
        60  moles = rate * TIME
        70  SAVE moles
        -end

IOM_CO2
 -start
 1  REM Arrhenius 1st-order kerogen degradation (single-Ea pool)
 10 k = 10^(13) * exp(-214000 / (8.314 * TK))
 20 rate = k * M
 30 if (M <= 0) then rate = 0
 40 moles = rate * TIME
 50 SAVE moles
 -end
IOM_CH4
 -start
 1  REM Arrhenius 1st-order kerogen degradation (single-Ea pool)
 10 k = 10^(13) * exp(-228000 / (8.314 * TK))
 20 rate = k * M
 30 if (M <= 0) then rate = 0
 40 moles = rate * TIME
 50 SAVE moles
 -end
IOM_N
 -start
 1  REM Arrhenius 1st-order kerogen degradation (single-Ea pool)
 10 k = 10^(13) * exp(-215000 / (8.314 * TK))
 20 rate = k * M
 30 if (M <= 0) then rate = 0
 40 moles = rate * TIME
 50 SAVE moles
 -end
IOM_S
 -start
 1  REM Arrhenius 1st-order kerogen degradation (single-Ea pool)
 10 k = 10^(13) * exp(-215000 / (8.314 * TK))
 20 rate = k * M
 30 if (M <= 0) then rate = 0
 40 moles = rate * TIME
 50 SAVE moles
 -end


# Define kinetic mineral phases with initial amounts
KINETICS 1
   Enstatite
      -m0 1.9480793
      -step_divide 1
   Forsterite
      -m0 1.37603355
      -step_divide 1
   Troilite
      -m0 2.0405474
      -step_divide 1
   Albite
      -m0 0.2715053
      -step_divide 1
   Diopside
      -m0 0.23487115
      -step_divide 1
   Anorthite
      -m0 0.05324655
      -step_divide 1
   K-Feldspar
      -m0 0.0175355
      -step_divide 1
   Tephroite
      -m0 0.0220473
      -step_divide 1
      IOM_CO2
      -formula C 1 H 1 O 1.3115
      -m0 6.253500e-01
      -step_divide 1
   IOM_CH4
      -formula C 1 H 4.435
      -m0 2.862000e-01
      -step_divide 1
   IOM_N
      -formula N 1 H 2
      -m0 1.312500e-01
      -step_divide 1
   IOM_S
      -formula S 1 H 1
      -m0 6.930000e-02
      -step_divide 1

   -steps 118800 in 1 steps
 
   -cvode true
   -bad_step_max 5000

    
