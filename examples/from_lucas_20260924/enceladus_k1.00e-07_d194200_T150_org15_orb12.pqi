# USER_PUNCH is defined per-cycle below (with exact cumulative time embedded)

# --- Cycle 1 of 12 (cumulative time: 3.7645e-03 years) ---
USE solution 1
USE kinetics 1
USE equilibrium_phases 1
USE reaction none
USE reaction_temperature 1
SAVE solution 1
SAVE equilibrium_phases 1
USER_PUNCH
   -headings Time_Years Enst_remain_g Forst_remain_g Troil_remain_g Alb_remain_g Diop_remain_g Anorth_remain_g Kfs_remain_g Teph_remain_g Total_Initial_g IOM_CO2_mol IOM_CH4_mol IOM_N_mol IOM_S_mol
   10 PUNCH 0.003765  # Cumulative time (years)
   20 PUNCH KIN("Enstatite") * 100.3725
   30 PUNCH KIN("Forsterite") * 140.6715
   40 PUNCH KIN("Troilite") * 87.913
   50 PUNCH KIN("Albite") * 262.1798
   60 PUNCH KIN("Diopside") * 216.55
   70 PUNCH KIN("Anorthite") * 278.164
   80 PUNCH KIN("K-Feldspar") * 278.33
   85 PUNCH KIN("Tephroite") * 201.96
   100 total_initial = 1.948079*100.3725 + 1.376034*140.6715 + 2.040547*87.913 + 0.271505*262.1798 + 0.234871*216.55 + 0.053247*278.164 + 0.017535*278.33 + 0.022047*201.96 + 2.023111*55.845 + 0.240725*58.693 + 0.009562*126.75
   110 PUNCH total_initial
   210 PUNCH KIN("IOM_CO2")
   220 PUNCH KIN("IOM_CH4")
   230 PUNCH KIN("IOM_N")
   240 PUNCH KIN("IOM_S")
END

USE kinetics none
USE equilibrium_phases 2
USE reaction none
USE reaction_temperature 2
MIX 4
  1  3.342308e-05
  2  1.0
SAVE solution 4
SAVE equilibrium_phases 2
END

USE kinetics none
USE equilibrium_phases none
USE reaction none
USE reaction_temperature 1
MIX 1
  1  9.999666e-01
  4  1.553143e-05
SAVE solution 1
END

USE kinetics none
USE equilibrium_phases none
USE reaction none
MIX 2
  4  9.999845e-01
SAVE solution 2
END
USER_PRINT
   10 IF KIN("Fayalite") > 0 THEN GOTO 30
   20 IF KIN("Pyrrhotite") <= 0 THEN GOTO 30
   25 IF EXISTS(1) THEN STOP
