DATABASE C:/Users/melwa/GitHub/ENTICES/coreclath_CH4coupled.dat
TITLE Test B3 -- Hdg carbon decoupling, REAL secondary mineral assemblage + real database
#
# SUPERSEDES test_B2_Hdg_carbon.pqi's "realistic" cases (sims 3/4 there used a
# 2-mineral toy assemblage -- Magnetite + Pyrrhotite only -- and
# Core11_idealgas_mod_v4.dat, which has no clathrates). This file uses:
#   - coreclath_CH4coupled.dat: the actual database in
#     ENTICES_LF_20260917.R's example run (has Hdg/Sg/Mtg/Ntg, confirmed
#     2026-09-24, AND three clathrate phases Mohit's copy lacks).
#   - The REAL 78-entry ocean secondary-mineral list (EQUILIBRIUM_PHASES 2),
#     extracted directly from phreeqc_inputs/from_lucas_20260924/
#     enceladus_k1.00e-07_d194200_T150_org15_orb12.pqi.out, not reconstructed
#     from memory. Ocean list chosen (not the 81-entry porewater list)
#     because it matches this test's cold/reducing conditions and because
#     clathrates only appear in the ocean list -- Lucas's own header comments
#     say clathrates are stable in the ocean at this pressure/temperature but
#     NOT in the 150C porewater.
#
# NEW THING THIS VERSION CAN TEST THAT THE TOY ASSEMBLAGE COULDN'T:
#   CH4_hydrate in this database is written as "CH4:6H2O = CH4 + 6 H2O" --
#   coupled CH4, not decoupled Mtg. So if methane ends up as Mtg (decoupled
#   mode), it should NOT be captured by clathrate formation at all. Sim 4
#   checks whether that's actually what happens, since it matters for
#   whether Option 3 quietly breaks clathrate modelling for exactly the
#   carbon this project cares about.
#
# Same core design as test_B2: sims 1-2 isolate the H2 mechanism with no
# minerals; sims 3-4 add the mineral list plus a small Fe/S inventory in
# solution; sim 5 is the calcite/carbonate-still-works check (unchanged from
# test_B2, since sims 1-2/5 already gave clean, unambiguous answers there).

SELECTED_OUTPUT 1
    -reset false
    -simulation true
    -pH true
    -pe true
    -totals C Hdg Fe S Ca
    -molalities CH4 Mtg CO2 HCO3- CO3-2 H2 Hdg CH4_hydrate CO2_hydrate H2S_hydrate
    -si Calcite Magnetite Pyrite CH4_hydrate CO2_hydrate

# ===========================================================================
# SIM 1 -- COUPLED H2, no minerals. Batch-reaction step (Halite at 0 moles,
#   a deliberate no-op) forces PHREEQC to actually equilibrate redox --
#   test_B (original) skipped this and its control never converted any
#   carbon at all, which is why it needed replacing in test_B2.
# ===========================================================================
SOLUTION 1 coupled-H2 reducing
    temp      1.45
    pH        11.5
    units     mol/kgw
    Na        0.1
    Cl        0.1 charge
    C         1e-3
    H(0)      1e-3
    water     1
    pressure  66.7
EQUILIBRIUM_PHASES 1
    Halite    0 0
END

# ===========================================================================
# SIM 2 -- DECOUPLED Hdg, otherwise identical to sim 1.
# ===========================================================================
SOLUTION 2 decoupled-Hdg
    temp      1.45
    pH        11.5
    units     mol/kgw
    Na        0.1
    Cl        0.1 charge
    C         1e-3
    Hdg       1e-3
    water     1
    pressure  66.7
EQUILIBRIUM_PHASES 2
    Halite    0 0
END

# ===========================================================================
# SIM 3 -- COUPLED H2, REAL 78-phase ocean secondary assemblage, small Fe/S
#   inventory in solution so the mineral list has something to respond to.
# ===========================================================================
SOLUTION 3 coupled-H2 with real assemblage
    temp      1.45
    pH        11.5
    units     mol/kgw
    Na        0.1
    Cl        0.1 charge
    C         1e-3
    Fe        1e-5
    S(-2)     1e-4
    H(0)      1e-3
    water     1
    pressure  66.7
EQUILIBRIUM_PHASES 3
